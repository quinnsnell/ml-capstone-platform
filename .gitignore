# Certificates & keys
_secrets/
star_cs_byu_edu*.zip
star_cs_byu_edu*/
*.pem
*.key
*.crt
*.pfx
*.p12
*-private-key*
*private-key*
MJ-test-key

# Environment files with real values
.env
.env.local
.env.production
coolify-env

# Real class rosters (FERPA — never commit real student emails/usernames).
# The example roster IS tracked so the file format is discoverable.
roster-*.csv
!roster-example.csv

# GitHub App private keys (extra explicit — any .pem ending)
ml-capstone-coolify*.pem
*-github-app*.pem

# Coolify state
coolify-*.tgz

# =============================================================================
# Build / cache junk
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
node_modules/
build/
dist/

# mdbook build output — regenerated by CI on every push
docs/book/

# =============================================================================
# Editor / OS
# =============================================================================
.DS_Store
*.swp
*.swo
.vscode/
.idea/
*~

# =============================================================================
# Nested repos (tracked separately on GitHub, not by this repo)
# =============================================================================
# Class app repos live at github.com/byu-ml-capstone/*. Keeping local clones
# here (alongside the platform code) is convenient for testing but each is its
# own git repo — exclude from this repo's tracking.
# Reference apps that live at the platform root but are their own repos
# on GitHub (byu-ml-capstone/*). Keep local clones for testing; don't
# track them as part of the platform repo.
sentiment-test-app/
hello-world-app/

# Student clones live under testing/, alongside the tracked
# test-playground/. Ignore every subdirectory of testing/ except the
# one we ship — pattern automatically covers any future student clone
# without needing per-name additions.
testing/*/
!testing/test-playground/

# =============================================================================
# Local test artifacts
# =============================================================================
.claude/

# =============================================================================
# Ad-hoc scripts kept local
# =============================================================================
sendsimplemessage.py
